# Copy to .env for local development. Every variable is optional except the VM ones (screen builds).
VM_HOST=monta@10.1.1.62
VM_USER=monta
VM_JOBROOT=C:\Users\monta\nxauto
# VM_EDITOR=C:\Program Files (x86)\Nextion Editor\Nextion Editor.exe
# SSH_KEY=/path/to/id_ed25519
# DATA_DIR=../../data
# PORT=8765
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_CODE_OAUTH_TOKEN=   (from `claude setup-token`; not needed if this machine is logged in to Claude Code)
# Or run the chat on a Hermes model through an OpenAI-compatible API instead of Claude (see README):
# AI_PROVIDER=hermes
# HERMES_BASE_URL=https://openrouter.ai/api/v1   (or http://localhost:11434/v1 for Ollama)
# HERMES_API_KEY=
# HERMES_MODEL=nousresearch/hermes-4-70b
# HERMES_STRONG_MODEL=nousresearch/hermes-4-405b
# PUBLIC_URL=https://arduino.example.com   (HTTPS address; shown when the app is opened over plain HTTP)
# ALLOW_BASH=1
