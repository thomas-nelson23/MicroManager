# Copy to .env for local development. Every variable is optional except the VM ones (screen builds).
VM_HOST=nextion@192.168.1.50
VM_USER=nextion
VM_JOBROOT=C:\Users\nextion\nxauto
# VM_EDITOR=C:\Program Files (x86)\Nextion Editor\Nextion Editor.exe
# SSH_KEY=/path/to/id_ed25519
# DATA_DIR=../../data
# PORT=8765
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_CODE_OAUTH_TOKEN=   (from `claude setup-token`; not needed if this machine is logged in to Claude Code)
# PUBLIC_URL=https://arduino.example.com   (HTTPS address; shown when the app is opened over plain HTTP)
# ALLOW_BASH=1
# FEEDBACK_REPO=owner/repo   (where the Feature requests tab opens GitHub issues; empty hides the button)
