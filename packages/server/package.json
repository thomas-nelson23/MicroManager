{
  "name": "@nextion-arduino/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend: projects on disk, Claude chat (Agent SDK), sketch and screen builds.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "exports": {
    "./protocol": "./src/protocol.ts",
    "./hmi-compact": "./src/hmi-compact.ts",
    "./boards": "./src/boards.ts",
    "./displays": "./src/displays.ts",
    "./wiring": "./src/wiring.ts",
    "./components.json": "./nextion/components.json"
  }
}
