{
  "name": "@nextion-arduino/flasher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flash Arduino, Teensy and RP2040 boards and upload Nextion TFTs (Web Serial / WebHID / File System Access in the browser, serialport in Node).",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node-transport.ts",
    "./web": "./src/web-transport.ts",
    "./web-hid": "./src/web-hid.ts",
    "./web-uf2": "./src/web-uf2.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/w3c-web-serial": "^1.0.9",
    "serialport": "^13.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
